# Supabase Configuration
# The unique identifier for your Supabase project.
SUPABASE_PROJECT_ID="your-supabase-project-id"
# The public/anonymous API key to access Supabase.
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
# The API URL for your Supabase instance.
SUPABASE_URL="https://your-supabase-url.supabase.co"
# The service role key for administrative/server-side bypass tasks.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Vite Supabase Configuration (Exposed to the Client)
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-supabase-url.supabase.co"

# Razorpay Payment Integration
# Public key ID for Razorpay frontend SDK
VITE_RAZORPAY_KEY_ID="rzp_test_your_key_id"
# Secret key for Razorpay API (keep safe, server-side only)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

